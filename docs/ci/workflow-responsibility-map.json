    "mobileArchitecture": {
      "hostWorkflow": "distributed",
      "mode": "six-lane mobile responsibility split with canonical Android Runtime artifact reuse active; legacy Android Native Shell / MOBILE-20A / MOBILE-20B workflow names are lightweight required-check compatibility gates because classic branch-protection requirements are not readable by the current integration",
      "lanes": {
        "client": [
          "mobile-ci.yml"
        ],
        "apiIntegration": [
          "mobile-api-integration.yml"
        ],
        "native": [
          "mobile-14-auth-app-links.yml"
        ],
        "build": [
          "mobile-13-store-release-preflight.yml",
          "mobile-android-runtime.yml"
        ],
        "e2e": [
          "mobile-android-runtime.yml",
          "mobile-ios-shell.yml",
          "mobile-native-shell.yml"
        ],
        "releaseStore": [
          "mobile-store-readiness.yml",
          "mobile-15-distribution-authority.yml",
          "mobile-android-runtime.yml",
          "mobile-20a-store-capture.yml",
          "mobile-20b-store-capture.yml",
          "mobile-20c-feature-graphic.yml",
          "mobile-20d-app-store-screenshots.yml"
        ]
      },
      "cutover": {
        "apiIntegration": {
          "canonicalOwner": "mobile-api-integration.yml",
          "duplicateOwnerRemoved": "mobile-ci.yml",
          "equivalenceEvidence": "PR #746 same-head Mobile API integration contracts + Mobile application contracts + Current Main Health GREEN"
        },
        "currentMain": {
          "duplicateStaticMobileChecksRemoved": [
            "auth",
            "initial-entry-routing",
            "camera",
            "face-guidance",
            "analyze",
            "saved-report",
            "public-share",
            "public-result-deep-link",
            "premium-entry",
            "my-skin-diary"
          ],
          "equivalenceEvidence": "PR #746 same-head dedicated Mobile owners + Current Main Health GREEN"
        },
        "androidRuntime": {
          "canonicalOwner": "mobile-android-runtime.yml",
          "compatibilityShims": [
            "mobile-native-shell.yml",
            "mobile-20a-store-capture.yml",
            "mobile-20b-store-capture.yml"
          ],
          "equivalenceEvidence": "PR #749 head bb3cc23c6d03b25fcc0a781b15a2ba9f1ea0b96f: canonical APK producer + Native Shell + MOBILE-20A + MOBILE-20B + all three legacy Android workflows + Current Main Health GREEN on the same head"
        }
      },
      "androidRuntimeConsolidation": {
        "canonicalWorkflow": "mobile-android-runtime.yml",
        "state": "canonical-runtime-active-with-required-check-compatibility-shims",
        "buildArtifact": "bejewely-mobile-android-debug-<candidate-sha>",
        "producerJob": "android-debug-apk",
        "consumers": [
          "native-shell-smoke",
          "store-capture-20a",
          "store-capture-20b"
        ],
        "requiredCheckCompatibilityShims": [
          "mobile-native-shell.yml",
          "mobile-20a-store-capture.yml",
          "mobile-20b-store-capture.yml"
        ],
        "compatibilityGate": "legacy job names wait for the same-head canonical mobile-android-runtime.yml run and fail closed unless it completes successfully",
        "branchProtectionVisibility": {
          "repositoryRulesets": "none-observed",
          "classicBranchProtection": "unreadable-by-current-integration-403"
        },
        "cutoverRule": "duplicate Android builds/emulators are retired after same-head equivalence; compatibility shims remain until classic required-check configuration can be audited safely"
      }
    }
