      "hostWorkflow": "distributed",
      "mode": "cross-cutting responsibility across admin, product-query, trust, offer and current-main health"
    },
    "database": {
      "hostWorkflow": "database-integration.yml",
      "mode": "canonical shared technical authority for migration inventory, historical-equivalence documentation and non-production target safety; full repository replay is not yet claimed; domain-specific Supabase runtime remains distributed",
      "scripts": [
        "scripts/verify-database-integration-authority.mjs",
        "scripts/assert-non-production-supabase-target.mjs"
      ]
    },
    "supplyChain": {
