  "schemaVersion": "bejewely-ci-workflow-responsibility-v2",
  "producerContractVersion": "watchtower-v0.3.2",
  "workflowInventoryDigest": "sha256:c7fec8524fd697262d5f60e2c54541ea209c954f9092e8fb96fd2fa6b3a0520f",
  "lastAuditedAt": "2026-09-24",
  "policy": {
    "purpose": "Separate workflow responsibility from CI Watchtower run-to-track attribution without changing verification behavior.",
    "workflowResponsibility": "A workflow has one primary technical responsibility and may expose multiple capability tags.",
    "watchtowerBinding": "CI Watchtower v0.3.2 uses three producer classes: project-wide workflows stay unassigned, dedicated workflows emit a canonical static [WT:<track>] run-name, and shared technical workflows resolve attribution dynamically from explicit PR/commit/branch evidence or workflow_dispatch inputs surfaced through run-name.",
    "preservation": "Existing workflow triggers, jobs, scripts, runtime probes, database harnesses, release jobs, and production probes are preserved until equivalence is proven before consolidation; proven duplicate verifier executions may then move to their canonical owner without deleting unique coverage."
  },
  "allowedPrimaryResponsibilities": [
    "global-governance",
    "security-boundary",
    "supply-chain-security",
    "ai-provider-runtime",
    "admin",
    "product-query-ai",
    "recommendation-admission",
    "product-offer-runtime",
    "catalog-taxonomy",
    "face-lab",
    "mobile",
    "trust-data-governance",
    "product-evidence",
    "product-data-pipeline"
  ],
  "embeddedResponsibilities": {
    "security": {
      "hostWorkflow": "security-boundary.yml",
      "mode": "dedicated-shared-technical-contract-suite; canonical owner after green equivalence proof; duplicate current-main executions removed",
      "scripts": [
        "scripts/run-security-boundary-verifier-suite.mjs",
        "scripts/verify-analysis-rls-contract.mjs",
        "scripts/verify-anonymous-write-grant-v2.mjs",
        "scripts/verify-sec06-saved-report-boundary.mjs",
        "scripts/verify-sec07-product-link-boundary.mjs",
        "scripts/verify-sec08-image-upload-boundary.mjs",
        "scripts/verify-sec09-public-result-read-boundary.mjs",
        "scripts/verify-sec10-image-origin-contract.mjs",
        "scripts/verify-sec10-security-headers.mjs",
        "scripts/verify-sec11-signout-boundary.mjs",
        "scripts/check-sec11-site-origin-normalization.mjs",
        "scripts/verify-sec12-error-log-boundary.mjs",
        "scripts/verify-sec12-mutations.mjs",
        "scripts/verify-provider-runtime-log-sanitization.mjs",
        "scripts/verify-current-repository-hygiene.mjs"
      ]
    },
    "siteE2E": {
      "hostWorkflow": "current-main-health.yml",
      "mode": "contract-in-canonical-ci; hosted runtime harness preserved separately",
      "scripts": [
        "scripts/verify-my-adversarial-e2e-contract.mjs",
        "scripts/run-my-adversarial-e2e.mjs",
        "scripts/run-premium-browser-journey.mjs",
        "playwright.config.ts"
      ]
    },
    "backend": {
      "hostWorkflow": "distributed",
      "mode": "cross-cutting responsibility across admin, product-query, trust, offer and current-main health"
    },
    "database": {
      "hostWorkflow": "distributed",
      "mode": "Supabase/RLS/migration/runtime checks remain distributed across trust, taxonomy, product-data and security responsibilities"
    },
    "supplyChain": {
      "hostWorkflow": "supply-chain-security.yml",
      "mode": "canonical shared technical owner; lockfile integrity, npm audit non-regression gate and CodeQL; GitHub Dependency Review pending repository Dependency Graph enablement",
      "scripts": [
        "scripts/verify-supply-chain-audit.mjs"
      ]
    },
    "aiProviderRuntime": {
      "hostWorkflow": "ai-provider-runtime.yml",
      "mode": "canonical shared technical owner after green equivalence proof; hermetic provider transport runtime on PR/push plus explicit non-persistent live OpenAI smoke on workflow_dispatch; duplicate current-main Unified Vision execution removed",
      "scripts": [
        "scripts/verify-ai-provider-runtime-boundary.mjs",
        "scripts/run-ai-provider-live-smoke.mjs",
        "scripts/verify-unified-vision-pipeline.mjs",
        "scripts/verify-provider-runtime-log-sanitization.mjs"
      ]
    }
  },
