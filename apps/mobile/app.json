{
  "expo": {
    "name": "BEJEWELY",
    "slug": "bejewely-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bejewely",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.bejewely.mobile",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "androidStatusBar": {
      "translucent": false
    }
  }
}
