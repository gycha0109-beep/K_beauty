{
  "name": "@bejewely/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "node ../../scripts/verify-mobile-architecture-foundation.mjs",
    "typecheck": "tsc --noEmit",
    "config:check": "expo config --type public",
    "export:android": "expo export --platform android --output-dir .expo-ci-dist",
    "prebuild:android": "expo prebuild --platform android --clean --no-install",
    "prebuild:ios": "expo prebuild --platform ios --clean --no-install",
    "build:android:debug": "cd android && ./gradlew :app:assembleDebug --no-daemon",
    "build:android:release": "cd android && ./gradlew :app:bundleRelease --no-daemon",
    "verify:native": "node ../../scripts/verify-mobile-native-shell.mjs"
  },
  "dependencies": {
    "@bejewely/shared": "*",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.13",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.28.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
