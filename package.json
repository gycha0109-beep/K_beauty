{
  "name": "k-beauty-ai-skin-test",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "promo:generate": "node scripts/generate-promo-content.mjs",
    "hwahae:prepare": "python -X utf8 scripts/hwahae-import/prepare_hwahae_batch.py",
    "hwahae:override": "python -X utf8 scripts/hwahae-import/prepare_hwahae_batch.py",
    "review_prepare": "node scripts/review-signals/review-prepare.mjs",
    "review_in_supabase": "node scripts/review-signals/review-in-supabase.mjs",
    "architecture:guard": "node scripts/architecture-guard.mjs",
    "check:sec11-origin-normalization": "node scripts/check-sec11-site-origin-normalization.mjs",
    "verify:premium-browser-journey": "node scripts/run-premium-browser-journey.mjs",
    "verify:premium-identical-retry": "node scripts/verify-premium-identical-retry.mjs",
    "verify:premium-browser-journey-contract": "node scripts/verify-premium-browser-journey-contract.mjs",
    "cleanup:premium-browser-journey": "node scripts/cleanup-premium-browser-journey.mjs",
    "e2e:premium:login": "node scripts/bootstrap-premium-e2e-auth.mjs",
    "e2e:premium:hosted": "node scripts/run-premium-browser-journey-local.mjs",
    "diagnose:premium:access": "node scripts/diagnose-premium-hosted-access.mjs",
    "diagnose:premium-session-cookie": "node scripts/diagnose-premium-session-cookie.mjs",
    "diagnose:premium-identical-retry": "node scripts/diagnose-premium-identical-retry.mjs",
    "verify:premium-session-runtime-diagnostics": "node scripts/verify-premium-session-runtime-diagnostics.mjs",
    "verify:premium-image-sanitizer-capacity": "node scripts/verify-premium-image-sanitizer-capacity.mjs",
    "check:premium-browser-journey-local": "node scripts/check-premium-browser-journey-local.mjs",
    "synthetic:test": "npm run test --workspace @bejewely/synthetic-evaluation",
    "synthetic:verify": "npm run verify --workspace @bejewely/synthetic-evaluation",
    "synthetic:import": "npm run import --workspace @bejewely/synthetic-evaluation --",
    "synthetic:observe": "npm run observe --workspace @bejewely/synthetic-evaluation --",
    "synthetic:judge": "npm run judge --workspace @bejewely/synthetic-evaluation --",
    "synthetic:consensus": "npm run consensus --workspace @bejewely/synthetic-evaluation --",
    "synthetic:align": "npm run align --workspace @bejewely/synthetic-evaluation --",
    "synthetic:promote": "npm run promote --workspace @bejewely/synthetic-evaluation --",
    "lint": "next lint"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.101.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "next": "15.5.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "playwright": "^1.59.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
